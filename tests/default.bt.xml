<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="Hibiki">
  <BehaviorTree ID="Hibiki">
    <ReactiveFallback name="Interaction before autonomous behavior">
      <ReactiveSequence name="Dragging interrupts animation">
        <IsDragging/>
        <LoopAnimation clip="Cafe_Idle"/>
      </ReactiveSequence>
      <Sequence name="Click reaction">
        <HasPendingClick />
        <PlayAnimation clip="Cafe_Reaction" consume_click="true" reset_cooldown="true" />
      </Sequence>
      <Sequence name="Random idle activity">
        <IdleCooldownReady min_seconds="5" max_seconds="12" />
        <PlayRandomAnimation clips="Cafe_Walk;Formation_Pickup;Exs" reset_cooldown="true" />
      </Sequence>
      <LoopAnimation clip="Cafe_Idle" />
    </ReactiveFallback>
  </BehaviorTree>
  <TreeNodesModel>
        <Condition ID="IsDragging"/>
        <Condition ID="HasPendingClick"/>
        <Condition ID="IdleCooldownReady">
            <input_port name="max_seconds" type="double" default="12.000000">Maximum idle delay</input_port>
            <input_port name="min_seconds" type="double" default="5.000000">Minimum idle delay</input_port>
        </Condition>
        <Action ID="LoopAnimation">
            <input_port name="clip" type="std::string">Model animation name</input_port>
        </Action>
        <Action ID="PlayAnimation">
            <input_port name="reset_cooldown" type="bool" default="true">Reset idle delay after completion or interruption</input_port>
            <input_port name="consume_click" type="bool" default="false">Consume one queued click at start</input_port>
            <input_port name="clip" type="std::string">Model animation name</input_port>
        </Action>
        <Action ID="PlayRandomAnimation">
            <input_port name="reset_cooldown" type="bool" default="true">Reset idle delay after completion or interruption</input_port>
            <input_port name="clips" type="std::string">Semicolon-separated model animation names</input_port>
        </Action>
    </TreeNodesModel>
</root>
