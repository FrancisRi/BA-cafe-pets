#include <windows.h>
1 RT_MANIFEST "@BA_ROOT@/native.manifest"
101 ICON "@BA_ROOT@/assets/app.ico"
1 VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "FileDescription", "@BA_FILE_DESCRIPTION@\0"
   VALUE "FileVersion", "@PROJECT_VERSION@\0"
   VALUE "InternalName", "ba_cafe_lite\0"
   VALUE "ProductName", "BA Cafe Pets\0"
   VALUE "Comments", "Based on maxiumlee/ba-cafe-lite; maintained by FrancisRi\0"
   VALUE "ProductVersion", "@PROJECT_VERSION@\0"
   VALUE "OriginalFilename", "@BA_BINARY_FILENAME@\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
