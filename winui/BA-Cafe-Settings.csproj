<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>BaCafe.Settings</RootNamespace>
    <AssemblyName>BaCafe.Settings</AssemblyName>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>true</SelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../assets/app.ico</ApplicationIcon>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9457" />
  </ItemGroup>
  <ItemGroup Condition="'$(PkgMicrosoft_WindowsAppSDK)' != ''">
    <Content Include="$(PkgMicrosoft_WindowsAppSDK)/license.txt" Link="licenses/WindowsAppSDK.txt" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(PkgMicrosoft_WindowsAppSDK)/NOTICE.txt" Link="licenses/WindowsAppSDK-NOTICE.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(NetCoreRoot)/LICENSE.txt')">
    <Content Include="$(NetCoreRoot)/LICENSE.txt" Link="licenses/dotnet.txt" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(NetCoreRoot)/ThirdPartyNotices.txt" Link="licenses/dotnet-NOTICE.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
