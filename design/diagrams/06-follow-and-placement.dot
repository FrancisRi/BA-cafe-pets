digraph G {
graph [rankdir=TB, bgcolor="transparent", pad=0.35, nodesep=0.45, ranksep=0.65, fontname="Microsoft YaHei", fontsize=18, splines=polyline];
node [shape=box, style="rounded,filled", fillcolor="#eef8fc", color="#7cafc3", fontcolor="#183848", fontname="Microsoft YaHei", fontsize=14, margin="0.18,0.15", width=3.8];
edge [color="#7093a3", fontcolor="#47697b", fontname="Microsoft YaHei", fontsize=12, arrowsize=0.65];
idle [label="基础动作处于 Idle\n非交互、非返程、非菜单暂停"];
dock [label="待机范围跨屏且需要检查？",shape=diamond,fillcolor="#fff5d9"];
target [label="固定单屏停靠目标\n允许散步且有 Walk：行走到目标\n否则一次放置到可停靠点"];
follow [label="开启位置跟随 + inputActive？\n有 Walk；无阻挡锁存/交互冷却",shape=diamond,fillcolor="#fff5d9"];
distance [label="距离在 [最近, 最远] 内？",shape=diamond,fillcolor="#fff5d9"];
stay [label="Idle 保持位置与朝向\n无需维持鼠标附近"];
plan [label="规划距离中点目标\n最近=0：只靠近、不远离\n每 0.15s 可重新规划"];
valid [label="路径可通行且落点完整在单屏？",shape=diamond,fillcolor="#fff5d9"];
walk [label="DirectedWalk 行走覆盖\n咖啡厅 Cafe_Walk / 战斗 Move_Ing\n末端约 0.35s 距离制动"];
boundary [label="仅战斗且存在 Jump？\n边界将到动作中点；落点可达\n朝向误差 ≤ 3°；无其他角色阻挡",shape=diamond,fillcolor="#fff5d9"];
jump [label="Move_Jump 播放一次\n方向和速度锁定、位移连续\n不重规划，不因到达距离而中断"];
finish [label="到达中点 / 固定目标？\n跨屏时先完整进入一个屏幕",shape=diamond,fillcolor="#fff5d9"];
arrive [label="停止 DirectedWalk → 基础 Idle\n停靠可恢复进入前朝向\n跟随不强制面向鼠标"];
blocked [label="碰撞 / 路径阻挡\n立即停止并放弃目的地\n鼠标移动 >16px 才解除重试锁存"];
inactive [label="输入不活跃\n结束普通跟随；跨屏/跳跃先完成\n允许散步后由各模式决定散步"];
override [label="强制交互或基础状态改变\n拖拽/旋转：即时取消\n非 Jump 攻击切换：取消覆盖",shape=note,fillcolor="#f4f6f8"];
idle -> dock [label=""];
dock -> target [label="是"];
dock -> follow [label="否"];
target -> valid [label="行走可用"];
target -> arrive [label="直接放置"];
follow -> distance [label="是"];
follow -> stay [label="否"];
distance -> stay [label="是且尚未移动"];
distance -> plan [label="区间外；或继续向中点移动"];
plan -> valid [label=""];
valid -> walk [label="是"];
valid -> stay [label="否；不启动不可达路径"];
walk -> boundary [label=""];
boundary -> jump [label="是"];
boundary -> finish [label="否；咖啡厅始终否"];
jump -> walk [label="落地；继续剩余行走"];
finish -> arrive [label="是"];
finish -> walk [label="否"];
walk -> blocked [label="步进碰撞"];
blocked -> idle [label="静止；等待解锁"];
stay -> inactive [label="无输入达阈值"];
inactive -> idle [label="散步结束"];
override -> arrive [label="取消覆盖",style=dashed,constraint=false];
}
