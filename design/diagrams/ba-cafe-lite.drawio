51.53" y="721.80" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="Jump" value="Jump · Move_Jump 单次\n提前起跳；边界位于动作中点\n保持方向、速度与连续位移" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="129.53" y="856.20" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="MoveEnd" value="MoveEnd · Move_End_姿态\n随机选择可用姿态；末段曲线转向\n按脚部采样减速至站稳" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="129.53" y="990.60" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="AttackStart" value="AttackStart · 姿态_Attack_Start\n准备攻击；保留首次攻击请求" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="759.53" y="730.20" width="273.60" height="55.20" as="geometry"/></mxCell><mxCell id="Attack" value="Attack · 姿态_Attack_Ing\n播放一次；重复按键可缓存" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="636.53" y="864.60" width="273.60" height="55.20" as="geometry"/></mxCell><mxCell id="AttackDelay" value="AttackDelay · 姿态_Attack_Delay\n循环等待；优先处理换弹请求" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="687.53" y="999.00" width="273.60" height="55.20" as="geometry"/></mxCell><mxCell id="AttackEnd" value="AttackEnd · 姿态_Attack_End\n收枪；可携带 reloadPending" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="880.53" y="1125.00" width="273.60" height="55.20" as="geometry"/></mxCell><mxCell id="Reload" value="Reload · 姿态_Reload\n或姿态_Attack_Reload；单次\n忽略键盘及换弹；清理攻击缓存" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="880.53" y="1242.60" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="Callsign" value="Callsign · 姿态_Callsign 单次\n按追踪开关面向鼠标\n全场随机一名候选再掷概率" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="1267.50" y="721.80" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="Pickup" value="Pickup · Formation_Pickup 循环\n缺少时用首姿态 Idle\n拖拽覆盖任何战斗状态" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="703.53" y="269.60" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="Skill" value="Skill · Exs 单次\n保存阶段、动作时间、剩余行走\n结束恢复保存状态" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="1374.50" y="173.60" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="VictoryStart" value="VictoryStart · Victory_Start 单次\n强制面向屏幕" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="884.53" y="182.00" width="273.60" height="55.20" as="geometry"/></mxCell><mxCell id="VictoryEnd" value="VictoryEnd · Victory_End × 3\n全过程强制面向屏幕" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;