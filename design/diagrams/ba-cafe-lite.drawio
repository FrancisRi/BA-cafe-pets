="1" pageWidth="949.6" pageHeight="1371.4"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="file" value="用户选择 GLB\n历史最多 15 条；显示最多 5 个" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="68.00" y="56.00" width="273.60" height="55.20" as="geometry"/></mxCell><mxCell id="validate" value="cgltf_parse / load_buffers / validate\nGLB 2.0；内嵌数据和 PNG/JPEG\n检查必需扩展与 accessor" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="68.00" y="160.20" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="error" value="不支持 / 数据损坏\n显示导入错误；保留已显示模型" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#fff0ef;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="32.00" y="303.00" width="273.60" height="55.20" as="geometry"/></mxCell><mxCell id="nodes" value="保留完整父节点层级\n多套 Skin、inverseBindMatrices\n节点 TRS / matrix、原始 Morph" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="338.00" y="294.60" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="tracks" value="读取原始关键帧\nSTEP / LINEAR / CUBICSPLINE\n不用 Blender 烘焙帧" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="338.00" y="415.60" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="catalog" value="关键词 / 别名 / 动作组映射\n选择一致 family + group\n歧义记录警告、跳过少数动作" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="338.00" y="536.60" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="parts" value="可选部件驱动检查\noptional + show/hide + 动画通道\n唯一塌缩 switch 面部保底" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="338.00" y="657.60" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="spatial" value="测量与缓存\n尺寸归一、眼高、本体宽度\n待机每网格边界、动作包络、脚部制动" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="338.00" y="778.60" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="caps" value="能力降级" style="shape=rhombus;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#fff5d9;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="338.00" y="899.60" width="273.60" height="76.80" as="geometry"/></mxCell><mxCell id="cafe" value="咖啡厅缺省映射\nIdle → 战斗 Idle / 首动作\nWalk → 战斗 Move；Pickup → Idle" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="32.00" y="1025.40" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="battle" value="战斗姿态必须 Idle + Attack\n优先 Normal；少姿态不参与随机\n无姿态：不提供战斗模式" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="338.00" y="1025.40" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="missing" value="可选动作不存在\nStart/End 跳过；Jump 不检查\n无 Delay 返回 Idle；无技能/换弹不触发" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="644.00" y="1025.40" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="runtime" value="生成/复用每角色 .bt.xml\n创建 Behavior 与 Battle\n原生模型就绪，进度 100%" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="338.00" y="1146.40" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="clip" value="运行帧\n采样 → 0.18s 内姿态混合\nMorph + 世界矩阵 + 蒙皮 → GPU" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="338.00" y="1267.40" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;" edge="1" parent="1" source="file" target="validate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-1" value="校验失败" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;" edge="1" parent="1" source="validate" target="error"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-2" value="合法" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;" edge="1" parent="1" source="validate" target="nodes"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;" edge="1" parent="1" source="nodes" target="tracks"><mxGeometry relative="1" as="geometry"/></mxCell><