/无输入条件" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;" edge="1" parent="1" source="Idle" target="Moving"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-15" value="可跨越屏幕/可见窗口；存在 Jump" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;" edge="1" parent="1" source="Moving" target="Jump"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-16" value="落地后仍有路程且允许走动" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;" edge="1" parent="1" source="Jump" target="Moving"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-17" value="落地后路程完成或走动关闭" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;" edge="1" parent="1" source="Jump" target="MoveEnd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-18" value="走完 / 禁用自动走动" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;" edge="1" parent="1" source="Moving" target="MoveEnd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-19" value="站稳且结束动作完成；缺 End 用 Walk 制动" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;" edge="1" parent="1" source="MoveEnd" target="Idle"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-20" value="拖拽" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;" edge="1" parent="1" source=