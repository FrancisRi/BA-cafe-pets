ft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="434.85" y="207.20" width="273.60" height="38.40" as="geometry"/></mxCell><mxCell id="cap" value="分析动作能力\n咖啡厅映射；战斗姿态集合" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="434.85" y="333.20" width="273.60" height="55.20" as="geometry"/></mxCell><mxCell id="mode" value="选择角色模式" style="shape=rhombus;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#fff5d9;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="128.85" y="459.20" width="273.60" height="76.80" as="geometry"/></mxCell><mxCell id="cafe" value="咖啡厅行为树\n拖拽 → 点击 → 返回起点\n散步 → Cafe_Idle" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="128.85" y="598.40" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="battle" value="战斗状态机\nIdle / Move / Attack / Reload\nCallsign / EX / Victory / Retreat" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="84.85" y="790.40" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="input" value="输入观测\n3s 宽限 → inputActive\n持续计时 / 无输入计时" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="443.85" y="461.60" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="follow" value="位置跟随覆盖\n仅基础 Idle + 输入活跃\n区间外启动，停在中点" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="747.85" y="694.40" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="dock" value="待机单屏停靠\n固定目标；避免 Idle 跨屏" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="561.85" y="798.80" width="273.60" height="55.20" as="geometry"/></mxCell><mxCell id="look" value="咖啡厅视线覆盖\n持续输入达到阈值\n平滑转身 / 30° 阈值转身" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="468.85" y="694.40" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="integrate" value="宿主整合当前帧\n曲线朝向、脚部减速\n碰撞停止、透视大小、深度排序" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="468.85" y="911.40" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="render" value="原生渲染与透明窗口\nCPU 蒙皮 → GPU → Win32" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="468.85" y="1032.40" width="273.60" height="55.20" as="geometry"/></mxCell><mxCell id="pause" value="暂停门\n睡眠 / 锁屏 / 熄屏：全部暂停\n菜单：行为暂停；Jump 继续" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="128.85" y="190.40" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="resume" value="恢复桌面\n重置帧计时与缓存\n继续当前动作" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="