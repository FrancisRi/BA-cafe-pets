" y="334.40" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="click" value="2 · Sequence\nHasPendingClick → PlayAnimation\nCafe_Reaction；消费一次点击" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="135.00" y="449.60" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="home" value="3 · ReturnHome\n散步后恢复输入且未开启位置跟随\nCafe_Walk；直线返回本轮起点" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="304.00" y="641.60" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="legacy" value="4 · 旧视线 Sequence（未启用）\nActiveInputChance → FaceCursor\n原生宿主 trackingEnabled=false" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#f2f3f5;strokeColor=#7cafc3;fontColor=#183848;dashed=1;" vertex="1" parent="1"><mxGeometry x="1164.00" y="161.60" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="wander" value="5 · ReactiveSequence\nUserInactive 达标 + 允许散步" style="shape=rhombus;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#fff5d9;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="473.97" y="315.20" width="357.67" height="110.40" as="geometry"/></mxCell><mxCell id="cooldown" value="Sequence\nIdleCooldownReady\n间隔 × 随机时间幅度" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="537.00" y="545.60" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="walk" value="WalkRandom → Cafe_Walk\n8 方向加权选择；距离带随机\n上行权重 0.4、路程倍率 2.5" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="551.00" y="737.60" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="idle" value="6 · LoopAnimation\nCafe_Idle\n纯待机动画速度 75%" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="864.00" y="334.40" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="finish" value="单次动作 / 返回 / 散步完成\n重置冷却，重新从根节点评估" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="377.00" y="872.00" width="273.60" height="55.20" as="geometry"/></mxCell><mxCell id="cap" value="导入时按能力修剪\n无 Reaction：移除点击分支\n无 Walk：移除返程和散步分支" style="shape=note;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="1470.00" y="161.60" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="override" value="宿主覆盖层（见移动/视线图）\n输入活跃 + 位置跟随会抑制随机散步\n跟随仍以基础 Idle 为宿主状态" style="shape=note;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="1776.00" y="161.60" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="fallback" value="XML 每 0.5s 检查更新\n无效更新保留旧树\n首次无效 / 执行异常 → SafeIdle" style="shape=note;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="858.00" y="161.60" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="edge-0" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=