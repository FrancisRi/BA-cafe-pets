lock;endFill=1;dashed=1;" edge="1" parent="1" source="reload" target="buffer"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-22" value="延后普通请求" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="jump" target="close"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="page-title" value="战斗打断与请求优先级" style="text;html=0;fontFamily=Microsoft YaHei;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="32" y="0" width="900" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="06-follow-and-placement" name="两模式公共移动 · 跟随与单屏停靠"><mxGraphModel dx="1280" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1410.8" pageHeight="1519.4"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="idle" value="基础动作处于 Idle\n非交互、非返程、非菜单暂停" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="623.00" y="64.40" width="273.60" height="55.20" as="geometry"/></mxCell><mxCell id="dock" value="待机范围跨屏且需要检查？" style="shape=rhombus;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#fff5d9;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="607.88" y="177.00" width="303.84" height="76.80" as="geometry"/></mxCell><mxCell id="target" value="固定单屏停靠目标\n允许散步且有 Walk：行走到目标\n否则一次放置到可停靠点" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="681.00" y="628.20" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="follow" value="开启位置跟随 + inputActive？\n有 Walk；无阻挡锁存/交互冷却" style="shape=rhombus;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#fff5d9;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="408.39" y="316.20" width="360.82" height="110.40" as="geometry"/></mxCell><mxCell id="distance" value="距离在 [最近, 最远] 内？" style="shape=rhombus;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#fff5d9;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="276.06" y="489.00" width="287.49" height="76.80" as="geometry"/></mxCell><mxCell id="stay" value="Idle 保持位置与朝向\n无需维持鼠标附近" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="296.00" y="910.20" width="273.60" height="55.20" as="geometry"/></mxCell><mxCell id="plan" value="规划距离中点目标\n最近=0：只靠近、不远离\n每 0.15s 可重新规划" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="283.00" y="628.20" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="valid" value="路径可通行且落点完整在单屏？" style="shape=rhombus;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#fff5d9;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="644.88" y="762.60" width="345.84" height="76.80" as="geometry"/></mxCell><mxCell id="walk" value="DirectedWalk 行走覆盖\n咖啡厅 Cafe_Walk / 战斗 Move_Ing\n末端约 0.35s 距离制动" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="681.00" y="901.80" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="boundary" value="仅战斗且存在 Jump？\n边界将到动作中点；落点可达\n朝向误差 ≤ 3°；无其他角色阻挡" style="shape=rhombus;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#fff5d9;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="482.38" y="1036.20" width="366.84" height="144.00" as="geometry"/></mxCell><mxCell id="jump" value="Move_Jump 播放一次\n方向和速度锁定、位移连续\n不重规划，不因到达距离而中断" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="307.00" y="1261.80" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="finish" value="到达中点 / 固定目标？\n跨屏时先完整进入一个屏幕" style="shape=rhombus;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#fff5d9;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="686.88" y="1242.60" width="303.84" height="110.40" as="geometry"/></mxCell><mxCell id="arrive" value="停止 DirectedWalk → 基础 Idle\n停靠可恢复进入前朝向\n跟随不强制面向鼠标" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="802.00" y="1415.40" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="blocked" value="碰撞 / 路径阻挡\n立即停止并放弃目的地\n鼠标移动 &gt;16px 才解除重试锁存" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="1089.00" y="1072.20" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="inactive" value="输入不活跃\n结束普通跟随；跨屏/跳跃先完成\n允许散步后由各模式决定散步" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="32.00" y="1072.20" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="override" value="强制交互或基础状态改变\n拖拽/旋转：即时取消\n非 Jump 攻击切换：取消覆盖" style="shape=note;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="1005.00" y="56.00" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;" edge="1" parent="1" source="idle" target="dock"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-1" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;" edge="1" parent="1" source="dock" target="target"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-2" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;" edge="1" parent="1" source="dock" target="follow"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-3" value="行走可用" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;" edge="1" parent="1" source="target" target="valid"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-4" value="直接放置" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;" edge="1" parent="1" source="target" target="arrive"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-5" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;" edge="1" parent="1" source="follow" target="distance"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-6" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;" edge="1" parent="1" source="follow" target="stay"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-7" value="是且尚未移动" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;" edge="1" parent="1" source="distance" target="stay"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-8" value="区间外；或继续向中点移动" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;" edge="1" parent="1" source="distance" target="plan"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;" edge="1" parent="1" source="plan" target="valid"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-10" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;" edge="1" parent="1" source="valid" target="walk"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-11" value="否；不启动不可达路径" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;" edge="1" parent="1" source="valid" target="stay"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;" edge="1" parent="1" source="walk" target="boundary"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-13" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;" edge="1" parent="1" source="boundary" target="jump"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-14" value="否；咖啡厅始终否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;" edge="1" parent="1" source="boundary" target="finish"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-15" value="落地；继续剩余行走" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;" edge="1" parent="1" source="jump" target="walk"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-16" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;" edge="1" parent="1" source="finish" target="arrive"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-17" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;" edge="1" parent="1" source="finish" target="walk"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-18" value="步进碰撞" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;" edge="1" parent="1" source="walk" target="blocked"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-19" value="静止；等待解锁" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;" edge="1" parent="1" source="blocked" target="idle"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-20" value="无输入达阈值" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;" edge="1" parent="1" source="stay" target="inactive"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-21" value="散步结束" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;" edge="1" parent="1" source="inactive" target="idle"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-22" value="取消覆盖" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="override" target="arrive"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="page-title" value="两模式公共移动 · 跟随与单屏停靠" style="text;html=0;fontFamily=Microsoft YaHei;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="32" y="0" width="900" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="07-cafe-look-tracking" name="咖啡厅视线追踪 · 与位置跟随独立"><mxGraphModel dx="1280" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="976.15" pageHeight="1180"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="input" value="inputActive 且 cafeTracking 开启？" style="shape=rhombus;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#fff5d9;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="507.45" y="56.00" width="436.70" height="76.80" as="geometry"/></mxCell><mxCell id="reset" value="重置追踪\n停止转身动画；保留当前朝向" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="32.00" y="222.80" width="273.60" height="55.20" as="geometry"/></mxCell><mxCell id="eligible" value="基础 Cafe_Idle 且无跟随/停靠/返程\n非拖拽/旋转/点击/菜单/交互冷却？" style="shape=rhombus;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#fff5d9;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="337.91" y="195.20" width="401.79" height="110.40" as="geometry"/></mxCell><mxCell id="wait" value="暂停本次转身\n等待基础动作重新允许追踪" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="160.00" y="551.60" width="273.60" height="55.20" as="geometry"/></mxCell><mxCell id="time" value="持续输入 ≥ activeSeconds\n且鼠标方向有效？" style="shape=rhombus;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#fff5d9;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="373.30" y="368.00" width="331.01" height="110.40" as="geometry"/></mxCell><mxCell id="mode" value="视线模式？" style="shape=rhombus;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#fff5d9;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="466.00" y="540.80" width="273.60" height="76.80" as="geometry"/></mxCell><mxCell id="smooth" value="平滑追踪\n每帧 turnToward 当前鼠标方向\n仍显示 Cafe_Idle；锚点不动" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="584.00" y="682.40" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="angle" value="当前未转身且角差 ≥ 30°？" style="shape=rhombus;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#fff5d9;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="233.88" y="680.00" width="317.84" height="76.80" as="geometry"/></mxCell><mxCell id="still" value="保持 Idle 与当前朝向" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="562.00" y="836.00" width="273.60" height="38.40" as="geometry"/></mxCell><mxCell id="turn" value="锁定本次 targetYaw\n转身覆盖 Cafe_Walk\n朝向最多变化 240°/s；位置不变" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="256.00" y="819.20" width="273.60" height="72.00" as="geometry"/></mxCell><mxCell id="done" value="与锁定方向角差 &lt; 0.5°？" style="shape=rhombus;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#fff5d9;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="274.48" y="953.60" width="298.63" height="76.80" as="geometry"/></mxCell><mxCell id="idle" value="结束转身 → Cafe_Idle\n后续角差再次达到 30° 才重启" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eef8fc;strokeColor=#7cafc3;fontColor=#183848;" vertex="1" parent="1"><mxGeometry x="528.00" y="1092.80" width="273.60" height="55.20" as="geometry"/></mxCell><mxCell id="edge-0" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;" edge="1" parent="1" source="input" target="reset"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-1" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;" edge="1" parent="1" source="input" target="eligible"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-2" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;" edge="1" parent="1" source="eligible" target="wait"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-3" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;" edge="1" parent="1" source="eligible" target="time"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-4" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;" edge="1" parent="1" source="time" target="wait"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-5" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;" edge="1" parent="1" source="time" target="mode"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-6" value="smooth" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;" edge="1" parent="1" source="mode" target="smooth"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-7" value="threshold" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;" edge="1" parent="1" source="mode" target="angle"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-8" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArrow=block;endFill=1;" edge="1" parent="1" source="angle" target="still"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge-9" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Microsoft YaHei;fontSize=12;strokeColor=#7093a3;fontColor=#47697b;endArro