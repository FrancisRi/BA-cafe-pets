digraph G {
graph [rankdir=TB, bgcolor="transparent", pad=0.35, nodesep=0.45, ranksep=0.65, fontname="Microsoft YaHei", fontsize=18, splines=polyline];
node [shape=box, style="rounded,filled", fillcolor="#eef8fc", color="#7cafc3", fontcolor="#183848", fontname="Microsoft YaHei", fontsize=14, margin="0.18,0.15", width=3.8];
edge [color="#7093a3", fontcolor="#47697b", fontname="Microsoft YaHei", fontsize=12, arrowsize=0.65];
event [label="本帧输入与当前阶段"];
buffer [label="先缓存请求\n攻击请求去重 ≥ 0.12s\n四个攻击阶段记录换弹请求"];
triple [label="角色 1.2s 内三连击？",shape=diamond,fillcolor="#fff5d9"];
retire [label="设置 Death / Retreat / 返回咖啡厅"];
drag [label="正在拖拽？",shape=diamond,fillcolor="#fff5d9"];
pickup [label="最高优先级 → Pickup\n清理技能/换弹；拖动立即返回"];
drop [label="刚结束拖拽？",shape=diamond,fillcolor="#fff5d9"];
reset [label="回首个姿态 Idle\n清理被打断技能状态"];
close [label="存在其他应用关窗请求？\n非 Jump、非退场、非胜利",shape=diamond,fillcolor="#fff5d9"];
victory [label="VictoryStart / VictoryEnd\nJump 中请求延后到落地"];
menu [label="菜单打开且不在 Jump？",shape=diamond,fillcolor="#fff5d9"];
hold [label="暂停行为\nJump 保持动画与移动"];
special [label="当前是 EX / 退场 / 胜利？",shape=diamond,fillcolor="#fff5d9"];
specialRun [label="推进对应动画并处理结束\n不尝试新的 EX / 常规状态条件"];
ex [label="输入活跃；EX 计时达阈值？\n非 Jump、非 Reload",shape=diamond,fillcolor="#fff5d9"];
try [label="存在 Exs 且概率成功？",shape=diamond,fillcolor="#fff5d9"];
skill [label="保存普通状态 → Skill"];
normal [label="常规 Phase 分支\nIdle：攻击 > 指挥 > 走动\nAttackDelay：换弹 > 收枪 > 攻击"];
reload [label="Reload 特例\n屏蔽键盘/换弹，不缓存攻击\n拖拽、三连击和关窗仍可打断",shape=note,fillcolor="#f4f6f8"];
jump [label="Jump 输入延后\n跟随 Jump：宿主缓存按键/换弹/关窗\n普通 Jump：攻击缓存、关窗延后",shape=note,fillcolor="#f4f6f8"];
event -> buffer [label=""];
buffer -> triple [label=""];
triple -> retire [label="是"];
triple -> drag [label="否"];
retire -> drag [label="拖拽仍可覆盖"];
drag -> pickup [label="是"];
drag -> drop [label="否"];
drop -> reset [label="是"];
drop -> close [label="否"];
reset -> close [label=""];
close -> victory [label="是"];
close -> menu [label="否"];
victory -> menu [label=""];
menu -> hold [label="是"];
menu -> special [label="否"];
special -> specialRun [label="是"];
special -> ex [label="否"];
ex -> try [label="是；计时归零"];
ex -> normal [label="否"];
try -> skill [label="是"];
try -> normal [label="否"];
reload -> buffer [label="屏蔽键盘请求",style=dashed,constraint=false];
jump -> close [label="延后普通请求",style=dashed,constraint=false];
}
