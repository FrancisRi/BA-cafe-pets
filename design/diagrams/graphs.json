        "label": "选择角色模式",
        "kind": "decision"
      },
      {
        "id": "cafe",
        "label": "咖啡厅行为树\n拖拽 → 点击 → 返回起点\n散步 → Cafe_Idle",
        "kind": "state"
      },
      {
        "id": "battle",
        "label": "战斗状态机\nIdle / Move / Attack / Reload\nCallsign / EX / Victory / Retreat",
        "kind": "state"
      },
      {
        "id": "input",
        "label": "输入观测\n3s 宽限 → inputActive\n持续计时 / 无输入计时",
        "kind": "state"
      },
      {
        "id": "follow",
        "label": "位置跟随覆盖\n仅基础 Idle + 输入活跃\n区间外启动，停在中点",
        "kind": "state"
      },
      {
        "id": "dock",
        "label": "待机单屏停靠\n固定目标；避免 Idle 跨屏",
        "kind": "state"
      },
      {
        "id": "look",
        "label": "咖啡厅视线覆盖\n持续输入达到阈值\n平滑转身 / 30° 阈值转身",
        "kind": "state"
      },
      {
        "id": "integrate",
        "label": "宿主整合当前帧\n曲线朝向、脚部减速\n碰撞停止、透视大小、深度排序",
        "kind": "state"
      },
      {
