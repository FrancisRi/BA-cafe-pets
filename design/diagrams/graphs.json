[
  {
    "key": "01-architecture",
    "title": "代码框架与线程边界",
    "description": "每个角色独立保存动作与位置；所有角色共享输入、设置和历史。只有 CPU 动画/蒙皮并行，OpenGL 与 Win32 提交始终在主线程。",
    "nodes": [
      {
        "id": "launch",
        "label": "单 EXE 启动器\nrelease_launcher.cpp\n解包缓存 → 启动原生核心",
        "kind": "state"
      },
      {
        "id": "entry",
        "label": "wWinMain / GraphicsContext\nmain.cpp\n隐藏 GLFW OpenGL 上下文",
        "kind": "state"
      },
      {
        "id": "scene",
        "label": "Scene · 场景协调\nscene.h\n最多 5 个角色；深度排序与避让",
        "kind": "state"
      },
      {
        "id": "input",
        "label": "NativeDesktopInput\nnative_input.h / input_activity.h\n异步 Raw Input；连续输入宽限 3s",
        "kind": "state"
      },
      {
        "id": "settings",
        "label": "NativeSettings + NativePreferences\nnative_settings.h / native_preferences.h\nWin32 菜单；共享设置",
        "kind": "state"
      },
      {
        "id": "roster",
        "label": "SceneRoster\nshared/scene_state.h\n历史 15 条；当前角色选择",
        "kind": "state"
      },
      {
        "id": "app",
        "label": "App · 每角色宿主\nmain.cpp\n模式、交互、行为、位置、渲染状态",
        "kind": "state"
      },
      {
        "id": "cafe",
        "label": "BehaviorTree.CPP 咖啡厅树\npet_behavior.h + template.bt.xml\n每角色 XML；热重载与安全 Idle",
        "kind": "state"
      },
      {
        "id": "battle",
        "label": "pet::Battle 战斗状态机\nshared/pet_battle.h\n16 个 Phase；按能力降级",
        "kind": "state"
      },
      {
        "id": "motion",
        "label": "公共移动与朝向\nPetGround / DirectedWalk\nCafeAttention / StopTurn / FootStop",
        "kind": "state"
      },
      {
        "id": "geometry",
        "label": "DesktopGeometry / DesktopPath\n每网格待机边界；单屏停靠\nVisibleWindowEdges：可见窗口边",
        "kind": "state"
      },
      {
        "id": "playback",
        "label": "pet::Playback\nclip / time / loop / generation\n动作请求与宿主位置汇入帧状态",
        "kind": "state"
      },
      {
        "id": "model",
        "label": "GltfModel · 独立 cgltf 适配\ngltf_model.cpp / gltf_model.h\n原始 GLB；多 Skin 与 Morph",
        "kind": "state"
      },
      {
        "id": "jobs",
        "label": "FrameJobs · 持久工作线程\nframe_jobs.h\n逐角色 CPU 动画 / 蒙皮",
        "kind": "state"
      },
      {
        "id": "barrier",
        "label": "主线程等待全部 CPU 任务\n单角色内联计算\n完成后才上传/销毁模型",
        "kind": "state"
      },
      {
        "id": "renderer",
        "label": "NativeRenderer\nnative_renderer.cpp\n动态顶点上传 → 材质/线条绘制",
        "kind": "state"
      },
      {
        "id": "fbo",
        "label": "紧凑 FBO + 至多 2× SSAA\nGPU 回读 RGBA\n缓存姿态范围、帧和命中区域",
        "kind": "state"
      },
      {
        "id": "win",
        "label": "Win32 透明显示 + 输入窗\nUpdateLayeredWindow + alpha Region\n置顶；透明区域鼠标穿透",
        "kind": "state"
      },
      {
        "id": "session",
        "label": "NativeSession + NativeLoop\n125 Hz 动作计时；60 FPS 绘制\n睡眠/锁屏/熄屏暂停；消息预算",
        "kind": "state"
      },
      {
        "id": "health",
        "label": "NativeHealth · 诊断观察线程\n主线程无进展 ≥ 8s\n保存 hang.txt / hang.dmp",
        "kind": "state"
      },
      {
        "id": "disk",
        "label": "本地数据\nsettings.ini / characters.json\nbehavior/*.bt.xml / logs/*",
        "kind": "data"
      }
