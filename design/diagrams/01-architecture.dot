digraph G {
graph [rankdir=TB, bgcolor="transparent", pad=0.35, nodesep=0.45, ranksep=0.65, fontname="Microsoft YaHei", fontsize=18, splines=polyline];
node [shape=box, style="rounded,filled", fillcolor="#eef8fc", color="#7cafc3", fontcolor="#183848", fontname="Microsoft YaHei", fontsize=14, margin="0.18,0.15", width=3.8];
edge [color="#7093a3", fontcolor="#47697b", fontname="Microsoft YaHei", fontsize=12, arrowsize=0.65];
launch [label="单 EXE 启动器\nrelease_launcher.cpp\n解包缓存 → 启动原生核心"];
entry [label="wWinMain / GraphicsContext\nmain.cpp\n隐藏 GLFW OpenGL 上下文"];
scene [label="Scene · 场景协调\nscene.h\n最多 5 个角色；深度排序与避让"];
input [label="NativeDesktopInput\nnative_input.h / input_activity.h\n异步 Raw Input；连续输入宽限 3s"];
settings [label="NativeSettings + NativePreferences\nnative_settings.h / native_preferences.h\nWin32 菜单；共享设置"];
roster [label="SceneRoster\nshared/scene_state.h\n历史 15 条；当前角色选择"];
app [label="App · 每角色宿主\nmain.cpp\n模式、交互、行为、位置、渲染状态"];
cafe [label="BehaviorTree.CPP 咖啡厅树\npet_behavior.h + template.bt.xml\n每角色 XML；热重载与安全 Idle"];
battle [label="pet::Battle 战斗状态机\nshared/pet_battle.h\n16 个 Phase；按能力降级"];
motion [label="公共移动与朝向\nPetGround / DirectedWalk\nCafeAttention / StopTurn / FootStop"];
geometry [label="DesktopGeometry / DesktopPath\n每网格待机边界；单屏停靠\nVisibleWindowEdges：可见窗口边"];
playback [label="pet::Playback\nclip / time / loop / generation\n动作请求与宿主位置汇入帧状态"];
model [label="GltfModel · 独立 cgltf 适配\ngltf_model.cpp / gltf_model.h\n原始 GLB；多 Skin 与 Morph"];
jobs [label="FrameJobs · 持久工作线程\nframe_jobs.h\n逐角色 CPU 动画 / 蒙皮"];
barrier [label="主线程等待全部 CPU 任务\n单角色内联计算\n完成后才上传/销毁模型"];
renderer [label="NativeRenderer\nnative_renderer.cpp\n动态顶点上传 → 材质/线条绘制"];
fbo [label="紧凑 FBO + 至多 2× SSAA\nGPU 回读 RGBA\n缓存姿态范围、帧和命中区域"];
win [label="Win32 透明显示 + 输入窗\nUpdateLayeredWindow + alpha Region\n置顶；透明区域鼠标穿透"];
session [label="NativeSession + NativeLoop\n125 Hz 动作计时；60 FPS 绘制\n睡眠/锁屏/熄屏暂停；消息预算"];
health [label="NativeHealth · 诊断观察线程\n主线程无进展 ≥ 8s\n保存 hang.txt / hang.dmp"];
disk [label="本地数据\nsettings.ini / characters.json\nbehavior/*.bt.xml / logs/*"];
launch -> entry [label=""];
entry -> scene [label=""];
input -> scene [label="输入事件"];
settings -> scene [label="参数 / 导入 / 列表操作"];
roster -> scene [label="显示角色"];
scene -> app [label="协调各角色"];
session -> scene [label="消息与计时"];
app -> cafe [label="咖啡厅"];
app -> battle [label="战斗"];
app -> motion [label=""];
motion -> geometry [label="路径与落点检查"];
cafe -> playback [label="动作请求"];
battle -> playback [label="动作请求"];
motion -> playback [label="位置 / 朝向 / 覆盖动作"];
model -> jobs [label="各模型独占一个任务"];
playback -> jobs [label="采样帧状态"];
jobs -> barrier [label="全部 future 完成"];
barrier -> renderer [label=""];
renderer -> fbo [label=""];
fbo -> win [label=""];
win -> input [label="本角色鼠标交互",style=dashed,constraint=false];
settings -> disk [label="保存 / 读取",style=dashed,constraint=false];
roster -> disk [label="保存 / 读取",style=dashed,constraint=false];
cafe -> disk [label="轮询 XML",style=dashed,constraint=false];
health -> disk [label="诊断文件",style=dashed,constraint=false];
health -> scene [label="观察阶段；不操作渲染",style=dashed,constraint=false];
}
