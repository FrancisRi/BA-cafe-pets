digraph G {
graph [rankdir=TB, bgcolor="transparent", pad=0.35, nodesep=0.45, ranksep=0.65, fontname="Microsoft YaHei", fontsize=18, splines=polyline];
node [shape=box, style="rounded,filled", fillcolor="#eef8fc", color="#7cafc3", fontcolor="#183848", fontname="Microsoft YaHei", fontsize=14, margin="0.18,0.15", width=3.8];
edge [color="#7093a3", fontcolor="#47697b", fontname="Microsoft YaHei", fontsize=12, arrowsize=0.65];
start [label="启动 / 导入 GLB"];
cap [label="分析动作能力\n咖啡厅映射；战斗姿态集合"];
mode [label="选择角色模式",shape=diamond,fillcolor="#fff5d9"];
cafe [label="咖啡厅行为树\n拖拽 → 点击 → 返回起点\n散步 → Cafe_Idle"];
battle [label="战斗状态机\nIdle / Move / Attack / Reload\nCallsign / EX / Victory / Retreat"];
input [label="输入观测\n3s 宽限 → inputActive\n持续计时 / 无输入计时"];
follow [label="位置跟随覆盖\n仅基础 Idle + 输入活跃\n区间外启动，停在中点"];
dock [label="待机单屏停靠\n固定目标；避免 Idle 跨屏"];
look [label="咖啡厅视线覆盖\n持续输入达到阈值\n平滑转身 / 30° 阈值转身"];
integrate [label="宿主整合当前帧\n曲线朝向、脚部减速\n碰撞停止、透视大小、深度排序"];
render [label="原生渲染与透明窗口\nCPU 蒙皮 → GPU → Win32"];
pause [label="暂停门\n睡眠 / 锁屏 / 熄屏：全部暂停\n菜单：行为暂停；Jump 继续"];
resume [label="恢复桌面\n重置帧计时与缓存\n继续当前动作"];
interact [label="用户交互\n左拖移动；右拖旋转；滚轮缩放\n右键点击菜单"];
exit [label="退出\n红色退出 / 快捷键\n关闭最后角色须确认",fillcolor="#fff0ef",color="#cc8c89"];
start -> cap [label=""];
cap -> mode [label="无战斗姿态只保留咖啡厅"];
mode -> cafe [label="cafe"];
mode -> battle [label="battle；有战斗能力"];
input -> cafe [label=""];
input -> battle [label=""];
input -> follow [label=""];
input -> look [label=""];
cafe -> battle [label="1.2s 内角色三连击；有战斗能力"];
battle -> cafe [label="死亡/退场结束；或菜单切模式"];
cafe -> integrate [label=""];
battle -> integrate [label=""];
follow -> integrate [label=""];
dock -> integrate [label=""];
look -> integrate [label=""];
integrate -> render [label=""];
interact -> integrate [label="强制交互 / 缩放"];
interact -> pause [label="打开菜单"];
pause -> resume [label="桌面可用 / 关闭菜单"];
resume -> mode [label="按现有模式继续"];
interact -> exit [label="明确退出或关闭最后角色"];
}
