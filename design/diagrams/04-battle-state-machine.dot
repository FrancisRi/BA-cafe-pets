digraph G {
graph [rankdir=TB, bgcolor="transparent", pad=0.35, nodesep=0.45, ranksep=0.65, fontname="Microsoft YaHei", fontsize=18, splines=polyline];
node [shape=box, style="rounded,filled", fillcolor="#eef8fc", color="#7cafc3", fontcolor="#183848", fontname="Microsoft YaHei", fontsize=14, margin="0.18,0.15", width=3.8];
edge [color="#7093a3", fontcolor="#47697b", fontname="Microsoft YaHei", fontsize=12, arrowsize=0.65];
entry [label="进入战斗 / 拖拽松开 / 胜利完成\n选首个可用姿态；ready=false",shape=note,fillcolor="#f4f6f8"];
Idle [label="Idle · 姿态_Idle\n循环；键盘、点击指挥、走动入口"];
Moving [label="Moving · Move_Ing 循环\n战斗速度 = 0.792 × zoom × 3\n输入走动距离 = 正常的 50%"];
Jump [label="Jump · Move_Jump 单次\n提前起跳；边界位于动作中点\n保持方向、速度与连续位移"];
MoveEnd [label="MoveEnd · Move_End_姿态\n随机选择可用姿态；末段曲线转向\n按脚部采样减速至站稳"];
AttackStart [label="AttackStart · 姿态_Attack_Start\n准备攻击；保留首次攻击请求"];
Attack [label="Attack · 姿态_Attack_Ing\n播放一次；重复按键可缓存"];
AttackDelay [label="AttackDelay · 姿态_Attack_Delay\n循环等待；优先处理换弹请求"];
AttackEnd [label="AttackEnd · 姿态_Attack_End\n收枪；可携带 reloadPending"];
Reload [label="Reload · 姿态_Reload\n或姿态_Attack_Reload；单次\n忽略键盘及换弹；清理攻击缓存"];
Callsign [label="Callsign · 姿态_Callsign 单次\n按追踪开关面向鼠标\n全场随机一名候选再掷概率"];
Pickup [label="Pickup · Formation_Pickup 循环\n缺少时用首姿态 Idle\n拖拽覆盖任何战斗状态"];
Skill [label="Skill · Exs 单次\n保存阶段、动作时间、剩余行走\n结束恢复保存状态"];
VictoryStart [label="VictoryStart · Victory_Start 单次\n强制面向屏幕"];
VictoryEnd [label="VictoryEnd · Victory_End × 3\n全过程强制面向屏幕"];
Death [label="Death · Vital_Death 单次"];
Retreat [label="Retreat · Vital_Retreat 单次\n显示方向 +180°；上升屏幕外\n位移按 t² 先慢后快"];
cafe [label="退出战斗 → 咖啡厅",fillcolor="#fff0ef",color="#cc8c89"];
interrupt [label="跨状态入口\n见优先级图",shape=note,fillcolor="#f4f6f8"];
saved [label="被 EX 打断的普通状态\n及其播放进度",shape=note,fillcolor="#f4f6f8"];
entry -> Idle [label=""];
Idle -> AttackStart [label="按键或已缓存按键；存在 Start"];
Idle -> Attack [label="按键；缺少 Start"];
AttackStart -> Attack [label="准备结束；执行首次攻击"];
Attack -> AttackDelay [label="攻击完成；若缺 Delay 则 Idle"];
AttackDelay -> Attack [label="新按键 / 缓存攻击"];
AttackDelay -> AttackEnd [label="无键盘 ≥ keyboardIdle"];
AttackDelay -> AttackEnd [label="有换弹请求且存在 End"];
AttackDelay -> Reload [label="换弹请求；缺少 End"];
AttackEnd -> Reload [label="结束后有请求且存在 Reload"];
AttackEnd -> Idle [label="结束后无换弹请求"];
Reload -> Idle [label="单次结束"];
Idle -> Callsign [label="鼠标抬键事件；当选且概率成功"];
Callsign -> Idle [label="结束；保持选中姿态"];
Idle -> Moving [label="允许走动；间隔到期 + 输入/无输入条件"];
Moving -> Jump [label="可跨越屏幕/可见窗口；存在 Jump"];
Jump -> Moving [label="落地后仍有路程且允许走动"];
Jump -> MoveEnd [label="落地后路程完成或走动关闭"];
Moving -> MoveEnd [label="走完 / 禁用自动走动"];
MoveEnd -> Idle [label="站稳且结束动作完成；缺 End 用 Walk 制动"];
interrupt -> Pickup [label="拖拽"];
Pickup -> entry [label="松开 / 取消拖拽"];
interrupt -> Skill [label="持续输入；EX 概率成功"];
saved -> Skill [label="保存",style=dashed,constraint=false];
Skill -> saved [label="播放完成：恢复",style=dashed,constraint=false];
interrupt -> VictoryStart [label="其他应用窗口关闭；有 Start"];
interrupt -> VictoryEnd [label="窗口关闭；缺 Start、有 End"];
VictoryStart -> VictoryEnd [label="Start 完成；有 End"];
VictoryStart -> entry [label="缺少 End"];
VictoryEnd -> VictoryEnd [label="已播放次数 < 3"];
VictoryEnd -> entry [label="第 3 次结束"];
interrupt -> Death [label="角色三连击；有 Death"];
interrupt -> Retreat [label="三连击；缺 Death、有 Retreat"];
interrupt -> cafe [label="三连击；两者都无"];
Death -> Retreat [label="死亡结束；有 Retreat"];
Death -> cafe [label="缺 Retreat"];
Retreat -> cafe [label="退场结束"];
}
